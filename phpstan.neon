includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8
    # Analyse as production's PHP minor version (8.3), whatever the runner is
    # (F-434). Without this the target follows the runner, so a CI bump would
    # move it silently. bcc-trust pins its target through composer.json's
    # config.platform.php instead; this repo sets no platform.
    phpVersion: 80300
    paths:
        - app/
    scanDirectories:
        - ../bcc-core/src/
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - bcc-search.php
    parallel:
        maximumNumberOfProcesses: 1
    treatPhpDocTypesAsCertain: false
